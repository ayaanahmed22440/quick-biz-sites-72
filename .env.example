# WebWarheads — environment variables
# Copy to .env and fill in real values. Never commit .env.

# ---- Database / auth (Supabase-compatible) ----
# Browser-visible (safe to expose)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-only (never expose to the browser)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Billing (Whop) ----
WHOP_API_KEY=
WHOP_WEBHOOK_SECRET=
WHOP_PLAN_ID_BASIC=
WHOP_PLAN_ID_SEO=
WHOP_PLAN_ID_PREMIUM=

# ---- Runtime ----
# Public address of the app, used for invitation and email links.
APP_URL=https://webwarheads.com
NODE_ENV=production
